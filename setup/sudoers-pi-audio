# On the audio Pi: lets backdrop (over SSH as bhf) pick which player gets the
# speakers: snapclient (backdrop), raspotify (Spotify Connect) or bluealsa-aplay
# (Bluetooth). Nothing else.
# Install on the Pi: sudo install -m 0440 sudoers-pi-audio /etc/sudoers.d/pi-audio
bhf ALL=(root) NOPASSWD: /usr/bin/systemctl stop snapclient, /usr/bin/systemctl start snapclient, /usr/bin/systemctl stop raspotify, /usr/bin/systemctl start raspotify, /usr/bin/systemctl stop bluealsa-aplay, /usr/bin/systemctl start bluealsa-aplay
