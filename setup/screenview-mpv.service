[Unit]
Description=backdrop mpv Display
After=network.target pulseaudio-screenview.service
Wants=pulseaudio-screenview.service

[Service]
Type=simple
User=screenview
SupplementaryGroups=video render
# Keep /run/screenview (the IPC socket) when the server restarts
RuntimeDirectory=screenview
RuntimeDirectoryPreserve=yes
Environment=HOME=/opt/screenview
Environment=PULSE_SERVER=unix:/run/screenview-pulse/pulse/native
ExecStart=/usr/bin/mpv --idle --force-window=yes \
    --input-ipc-server=/run/screenview/mpv.sock \
    --vo=gpu-next --gpu-context=drm --hwdec=vaapi --fs --ao=pulse \
    --no-terminal --really-quiet \
    --no-input-default-bindings --no-osc --no-osd-bar \
    --image-display-duration=inf \
    --background=color --background-color=#000000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
