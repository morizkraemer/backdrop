[Unit]
Description=backdrop Media Server
After=network.target screenview-mpv.service

[Service]
Type=simple
User=screenview
WorkingDirectory=/opt/screenview
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=MPV_SOCKET=/run/screenview/mpv.sock
# Bluetooth Pi settings (BT_HOST, BT_USER, BT_PASSWORD) go in the gitignored .env
EnvironmentFile=-/opt/screenview/.env

[Install]
WantedBy=multi-user.target
