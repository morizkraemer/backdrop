#define COLS 12.0
#define ROWS 4.0

// Cell i's level, in reading order from the top left
float cellLevel(int i) {
    switch (i) {
    case 0: return c1;
    case 1: return c2;
    case 2: return c3;
    case 3: return c4;
    case 4: return c5;
    case 5: return c6;
    case 6: return c7;
    case 7: return c8;
    case 8: return c9;
    case 9: return c10;
    case 10: return c11;
    case 11: return c12;
    case 12: return c13;
    case 13: return c14;
    case 14: return c15;
    case 15: return c16;
    case 16: return c17;
    case 17: return c18;
    case 18: return c19;
